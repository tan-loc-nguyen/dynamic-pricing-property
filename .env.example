# ---------------------------------------------------------------------------
# dynamic-pricing-property — environment configuration
#
# Copy to .env (make setup does this automatically).
# The defaults below run the full product in demo mode with NO credentials.
# NEVER commit a real .env — it is gitignored.
# ---------------------------------------------------------------------------

# --- Data providers --------------------------------------------------------
# mock     = synthetic Luminous-like portfolio (default, always works)
# snapshot = sanitized real Blue Jay data captured earlier; works offline and
#            outside Blue Jay's testing windows. The preferred DEMO source.
# bluejay  = the live Blue Jay test API (see docs/BLUEJAY_CONTRACT.md)
#
# This only SEEDS the value. The active source is stored in the database and
# switched in Settings -> Data, so a demo machine does not need a file edit and
# a restart to change it.
DATA_PROVIDER=mock

# mock | manual | public_web
MARKET_PROVIDER=mock

# --- Server ----------------------------------------------------------------
API_HOST=127.0.0.1
API_PORT=8000
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# --- Database --------------------------------------------------------------
# Defaults to <repo>/data/dynamic_pricing.db
# DATABASE_URL=sqlite:////absolute/path/to/dynamic_pricing.db

# --- Demo data -------------------------------------------------------------
SEED_ON_STARTUP=true
DEMO_SEED=20260822

# ---------------------------------------------------------------------------
# Blue Jay PMS  —  READ-ONLY.  This app never writes to Blue Jay.
#
# NOT REQUIRED for demo mode. Set these to reach the live test API; the data
# source itself is switched in Settings -> Data, not here (this only seeds it).
#
# Calls are accepted ONLY during Blue Jay's Vietnam-time testing windows
# (08:00-08:30 and 16:00-16:59). The client refuses to send outside them,
# before the request leaves the process.
#
# See docs/BLUEJAY_CONTRACT.md for the field mapping and what is still
# unverified.
# ---------------------------------------------------------------------------
BLUEJAY_BASE_URL=https://api1.bluejaypms.com/api/v2
# NEVER commit a real key.
BLUEJAY_API_KEY=
# Luminous' own hotelId. NOT 1003 — that is the different property used in the
# API document's examples.
BLUEJAY_HOTEL_ID=
BLUEJAY_TIMEOUT_SECONDS=15

# VERIFIED 2026-08-27 against api1: the header is `apikey`, sent raw.
# The English translation of the API document gave the base URL as
# api-test.bluejaypms.com. That host exists and serves a DIFFERENT
# (booking-engine) API, so every documented endpoint 404s there. The original
# Vietnamese says api1. Kept configurable in case a tenant differs.
#   style "raw"    -> "<BLUEJAY_AUTH_HEADER>: <key>"
#   style "bearer" -> "<BLUEJAY_AUTH_HEADER>: Bearer <key>"
BLUEJAY_AUTH_HEADER=apikey
BLUEJAY_AUTH_STYLE=raw

# Salt for pseudonymising booking codes in a capture.
# MUST be set before capturing anything real: booking codes are 6-digit
# numerics, so against the built-in fixture salt a full rainbow table is about
# a second's work and every real code is recoverable from the snapshot.
# Generate one with:  openssl rand -hex 16
# Keep it STABLE — changing it makes new captures incomparable with old ones.
BLUEJAY_PSEUDONYM_SALT=

# Where `scripts/bluejay_probe.py --capture` writes, and SNAPSHOT mode reads.
# Captures are GITIGNORED: this repo is public and the test tenant is a third
# party's hotel. Move snapshots to a demo machine out of band.
# BLUEJAY_SNAPSHOT_DIR=apps/api/snapshots/current

# ---------------------------------------------------------------------------
# Public market-data prototype  (OFF by default — see docs/MARKET_DATA.md)
#
# Only ever point this at public pages whose robots.txt permits access.
# The collector refuses OTA hosts (Airbnb/Booking/Agoda/Expedia/Trip) and will
# not bypass CAPTCHA, logins or anti-bot controls.
# ---------------------------------------------------------------------------
MARKET_PUBLIC_ENABLED=false

# Comma-separated public URLs. A source may be a TEMPLATE carrying the stay
# dates into the request:
#
#   https://a-comparable-hotel.example/booking?checkin={checkin}&checkout={checkout}
#
# A template is fetched ONCE PER NIGHT (capped at 30 per run) and each price is
# filed under the night it was asked about. Without the placeholders the URL is
# fetched once and its price is filed under the range start only -- honest, but
# it cannot fill a per-night market band.
#
# Everything collected this way is LOW confidence and never moves a rate: a
# public page does not state length of stay, room category, tax basis or
# promotion status. See docs/MARKET_DATA.md.
MARKET_PUBLIC_SOURCES=
MARKET_USER_AGENT=DynamicPricingProperty/0.1 (+localhost MVP; contact: ops@luminous.example)
MARKET_HTTP_TIMEOUT_SECONDS=10
