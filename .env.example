# ---------------------------------------------------------------------------
# dynamic-pricing-property — environment configuration
#
# Copy to .env (make setup does this automatically).
# The defaults below run the full product in demo mode with NO credentials.
# NEVER commit a real .env — it is gitignored.
# ---------------------------------------------------------------------------

# --- Data providers --------------------------------------------------------
# mock     = synthetic Luminous-like portfolio (default, always works)
# snapshot = sanitized real Blue Jay data captured earlier; works offline and
#            outside Blue Jay's testing windows. The preferred DEMO source.
# bluejay  = the live Blue Jay test API (see docs/BLUEJAY_CONTRACT.md)
#
# This only SEEDS the value. The active source is stored in the database and
# switched in Settings -> Data, so a demo machine does not need a file edit and
# a restart to change it.
DATA_PROVIDER=mock

# mock | manual | public_web
MARKET_PROVIDER=mock

# --- Server ----------------------------------------------------------------
API_HOST=127.0.0.1
API_PORT=8000
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# --- Database --------------------------------------------------------------
# Defaults to <repo>/data/dynamic_pricing.db
# DATABASE_URL=sqlite:////absolute/path/to/dynamic_pricing.db

# --- Demo data -------------------------------------------------------------
SEED_ON_STARTUP=true
DEMO_SEED=20260822

# ---------------------------------------------------------------------------
# Blue Jay PMS
#
# NOT REQUIRED for demo mode. The adapter boundary exists but is not wired to
# live endpoints: the Blue Jay API documentation was not available when this
# MVP was built, so no endpoints or field mappings were assumed.
# See docs/BLUEJAY.md for the unresolved mappings.
# ---------------------------------------------------------------------------
BLUEJAY_BASE_URL=
BLUEJAY_API_KEY=
BLUEJAY_PROPERTY_IDS=
BLUEJAY_TIMEOUT_SECONDS=15
# bearer -> "Authorization: Bearer <key>";  header -> "<BLUEJAY_AUTH_HEADER>: <key>"
BLUEJAY_AUTH_STYLE=bearer
BLUEJAY_AUTH_HEADER=Authorization

# ---------------------------------------------------------------------------
# Public market-data prototype  (OFF by default — see docs/MARKET_DATA.md)
#
# Only ever point this at public pages whose robots.txt permits access.
# The collector refuses OTA hosts (Airbnb/Booking/Agoda/Expedia/Trip) and will
# not bypass CAPTCHA, logins or anti-bot controls.
# ---------------------------------------------------------------------------
MARKET_PUBLIC_ENABLED=false
MARKET_PUBLIC_SOURCES=
MARKET_USER_AGENT=DynamicPricingProperty/0.1 (+localhost MVP; contact: ops@luminous.example)
MARKET_HTTP_TIMEOUT_SECONDS=10

# --- Blue Jay PMS ----------------------------------------------------------
# READ-ONLY. This app never writes to Blue Jay.
# Calls are only accepted during Blue Jay's Vietnam-time testing windows
# (08:00-08:30 and 16:00-16:59); the client refuses to send outside them.
# BLUEJAY_BASE_URL=https://api-test.bluejaypms.com/api/v2
# BLUEJAY_API_KEY=            # NEVER commit this
# BLUEJAY_HOTEL_ID=           # 1003 in the doc is a DIFFERENT property
# BLUEJAY_TIMEOUT_SECONDS=15

# Salt for pseudonymising booking codes in a capture. MUST be set before
# capturing real data: booking codes are 6-digit numerics, so with the built-in
# fixture salt a full rainbow table is built in about a second.
# BLUEJAY_PSEUDONYM_SALT=

# Where `scripts/bluejay_probe.py --capture` snapshots are read from.
# Captures are GITIGNORED — this repo is public and the test tenant is a third
# party's hotel. Move snapshots to a demo machine out of band.
# BLUEJAY_SNAPSHOT_DIR=apps/api/snapshots/current
