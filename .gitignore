# Secrets — never commit
.env
.env.local
*.pem
*.key

# Python
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
.ruff_cache/

# Node
node_modules/
.next/
out/
npm-debug.log*
.pnpm-debug.log*

# Database (regenerate with `make reseed`)
data/*.db
data/*.db-shm
data/*.db-wal
# Schema changes are migrated by reseed (D24), which means deleting the file --
# so a backup is taken first, and it is just as much a database as the original.
data/*.db.backup-*

# OS / editor
.DS_Store
.idea/
.vscode/
*.swp

# Build artefacts
tsconfig.tsbuildinfo

# Packaged desktop build (`make bundle`) and CI artefacts pulled with
# `gh run download` — ~22MB per platform
dist/
build/
release/

# Client source documents — NEVER commit (repo is public)
private/
*.pdf
# .docx too: the Blue Jay source document arrived as one and landed at the
# repo root, where only *.pdf was covered.
*.docx
*.doc
*.xlsx

# Blue Jay captures — NEVER commit (repo is public, and the test tenant is a
# THIRD PARTY's hotel). captures/ holds raw responses including guest names and
# identity-document references; snapshots/ holds sanitized replays, which are
# still another company's commercial booking data. Both ship to a demo machine
# out of band. Parser tests run on the small synthetic fixture in tests/.
apps/api/captures/
apps/api/snapshots/
